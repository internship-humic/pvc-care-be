# ==========================================
#   PVC Care Backend — Environment Variables
# ==========================================
# Salin file ini menjadi .env dan sesuaikan nilainya.
# JANGAN pernah commit file .env ke repositori!

# --- Server ---
PORT=3000

# --- Database (PostgreSQL + PostGIS) ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/pvc_care_db?schema=public"

# --- JSON Web Token ---
JWT_SECRET="ganti_dengan_secret_key_yang_sangat_panjang_dan_acak"
JWT_EXPIRES_IN="7d"
